#version 450
// 13 candidates, five luma taps cached once per 16x16 tile. Reconstruct
// four pixels per lane. No extra optical-flow texture or GPU readback.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D previousFrame;
layout(binding=1) uniform sampler2D currentFrame;
layout(binding=2,rgba16f) uniform writeonly image2D generatedFrame;
const ivec2 offsets[13]=ivec2[13](ivec2(0),ivec2(8,0),ivec2(-8,0),ivec2(0,8),ivec2(0,-8),
    ivec2(8,8),ivec2(-8,8),ivec2(8,-8),ivec2(-8,-8),ivec2(16,0),ivec2(-16,0),ivec2(0,16),ivec2(0,-16));
const ivec2 taps[5]=ivec2[5](ivec2(0),ivec2(-4,-4),ivec2(4,-4),ivec2(-4,4),ivec2(4,4));
shared float currentLuma[5];
shared float costs[13];
shared ivec2 motion;
shared float confidence;
float luma(vec3 c) { return dot(c,vec3(0.2126,0.7152,0.0722)); }
void main() {
    ivec2 size=imageSize(generatedFrame);
    ivec2 tile=ivec2(gl_WorkGroupID.xy)*16;
    ivec2 center=min(tile+8,size-1);
    uint lane=gl_LocalInvocationIndex;
    if(lane<5u) currentLuma[lane]=luma(texelFetch(currentFrame,clamp(center+taps[lane],ivec2(0),size-1),0).rgb);
    barrier();
    if(lane<13u) {
        ivec2 d=offsets[lane];
        float cost=0.0;
        for(int i=0;i<5;++i) {
            vec3 a=texelFetch(previousFrame,clamp(center+taps[i]-d,ivec2(0),size-1),0).rgb;
            cost+=abs(luma(a)-currentLuma[i]);
        }
        costs[lane]=cost*0.2+0.0002*float(abs(d.x)+abs(d.y));
    }
    barrier();
    if(lane==0u) {
        uint best=0u;
        for(uint i=1u;i<13u;++i) if(costs[i]<costs[best]) best=i;
        motion=offsets[best];
        float stationary=costs[0], residual=costs[best];
        confidence=clamp((stationary-residual)/max(stationary,0.001),0.0,1.0)
                   *(1.0-smoothstep(0.035,0.12,residual));
        if(best==0u || residual>0.12 || stationary<0.015) confidence=0.0;
    }
    barrier();
    ivec2 origin=tile+ivec2(gl_LocalInvocationID.xy)*2;
    vec2 shift=vec2(motion)*0.5/vec2(size);
    for(int y=0;y<2;++y) for(int x=0;x<2;++x) {
        ivec2 p=origin+ivec2(x,y);
        if(any(greaterThanEqual(p,size))) continue;
        vec4 real=texelFetch(currentFrame,p,0);
        vec2 uv=(vec2(p)+0.5)/vec2(size);
        vec2 a=uv-shift,b=uv+shift;
        if(confidence<0.35 || any(lessThan(a,vec2(0))) || any(greaterThan(a,vec2(1))) ||
           any(lessThan(b,vec2(0))) || any(greaterThan(b,vec2(1)))) {
            imageStore(generatedFrame,p,real); continue;
        }
        vec3 before=textureLod(previousFrame,a,0.0).rgb, after=textureLod(currentFrame,b,0.0).rgb;
        vec3 diff=abs(before-after);
        float mismatch=max(max(diff.r,diff.g),diff.b);
        float weight=confidence*(1.0-smoothstep(0.06,0.20,mismatch));
        imageStore(generatedFrame,p,vec4(mix(real.rgb,mix(before,after,0.5),weight),real.a));
    }
}
